SPOTIFY_CLIENT_ID="your_client_id"
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_API_BASE=https://api.spotify.com/v1
SPOTIFY_AUTH_BASE=https://accounts.spotify.com/api
SPOTIFY_AUTHORIZE_URL=https://accounts.spotify.com/authorize
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback
SPOTIFY_SCOPES="user-top-read user-read-recently-played user-read-private"
SPOTIFY_OAUTH_ADMIN_USERNAME=admin
SPOTIFY_OAUTH_ADMIN_PASSWORD=replace_with_a_long_random_password
SPOTIFY_POST_AUTH_REDIRECT=/card/rewrapped
SPOTIFY_REAUTH_URL=http://localhost:8000/spotify/login
REQUEST_TIMEOUT=15
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB=rewrapped
MONGODB_COLLECTION=plays
SPOTIFY_TOKEN_COLLECTION=spotify_tokens
